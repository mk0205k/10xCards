# .env.e2e — local-only credentials for Playwright E2E tests.
# Copy this file to `.env.e2e` and fill in the values.
# DO NOT commit the filled `.env.e2e` — it is gitignored.
#
# Prerequisites:
# 1. `npx supabase start` (local stack running)
# 2. Sign up `e2e-north-star@local.test` once via `/auth/signup`
# 3. Copy this file to `.env.e2e` and set the password below

E2E_USER_EMAIL=e2e-north-star@local.test
E2E_USER_PASSWORD=<local-only>

# Optional: override baseURL if running the dev server on a non-default port.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:4321
